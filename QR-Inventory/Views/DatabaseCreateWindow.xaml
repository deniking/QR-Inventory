<Window x:Class="QR_Inventory.Views.DatabaseCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание базы данных"
        Height="300" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Icon="/QR_Inventory;component/Assets/Icons/db.png">

    <Border CornerRadius="12"
            Background="{DynamicResource PanelBrush}"
            Padding="20"
            Margin="10"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- заголовок -->
                <RowDefinition Height="20"/>     <!-- отступ -->
                <RowDefinition Height="Auto"/>   <!-- путь -->
                <RowDefinition Height="10"/>     <!-- отступ -->
                <RowDefinition Height="Auto"/>   <!-- имя файла -->
                <RowDefinition Height="*" />     <!-- растяжка -->
                <RowDefinition Height="Auto"/>   <!-- кнопки -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0"
                       Text="Создание базы данных"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}"/>

            <!-- Путь к папке -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,5">
                <Label Content="Путь к папке:"
                       Width="130"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="PathBox"
                         Width="280"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"/>
                <Button Width="35"
                        Height="32"
                        Margin="0,0,0,0"
                        Click="Browse_Click"
                        Background="{DynamicResource ButtonBrush}"
                        Foreground="{DynamicResource ButtonTextBrush}"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="📁"
                               FontSize="16"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- Имя файла -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Label Content="Имя файла:"
                       Width="130"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="FileNameBox"
                         Width="320"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <Button Content="Создать"
                        Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        Click="Create_Click"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Отмена"
                        Width="100"
                        Height="32"
                        Click="Cancel_Click"
                        Background="{DynamicResource ButtonBrush}"
                        Foreground="{DynamicResource ButtonTextBrush}"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
