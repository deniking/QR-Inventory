<Window x:Class="QR_Inventory.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR-Inventory — Вход"
        Height="380"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="../Assets/Icons/app.ico"
        Background="{StaticResource BgBrush}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Авторизация"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,5,0,0">
            <TextBlock Text="Логин:" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameBox"
                     Height="30"
                     FontSize="14"
                     Background="{StaticResource PanelBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock Text="Пароль:" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="30"
                         FontSize="14"
                         Background="{StaticResource PanelBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Padding="5"/>
        </StackPanel>

        <CheckBox x:Name="RememberCheckBox"
                  Grid.Row="3"
                  Content="Запомнить меня"
                  Foreground="{StaticResource TextBrush}"
                  Margin="0,15,0,0"
                  FontSize="13"/>

        <Button Grid.Row="4"
                Content="Войти"
                Height="38"
                Margin="0,25,0,0"
                Background="{StaticResource AccentBrush}"
                Foreground="{StaticResource TextBrush}"
                BorderThickness="0"
                Cursor="Hand"
                FontSize="15"
                HorizontalAlignment="Center"
                Width="120"
                IsDefault="True"
                Click="Login_Click"/>
    </Grid>
</Window>
