<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== КИСТИ (ЦВЕТА ТЁМНОЙ ТЕМЫ) ===== -->
    <SolidColorBrush x:Key="BgBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#2A2A2C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#252525"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>



    <!-- Выпадающее меню -->
    <SolidColorBrush x:Key="MenuPopupBrush" Color="#2F2F31"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="MenuBorderPopupBrush" Color="#404040"/>

    <!-- лёгкая тень под popup -->
    <DropShadowEffect x:Key="PopupShadow"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Opacity="0.4"
                      Color="Black"/>

    <!-- ================= ВЕРХНИЙ УРОВЕНЬ МЕНЮ ================= -->
    <Style x:Key="TopMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="3,0"/>
        <!-- 🔹 добавляем зазор между пунктами -->
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="3">
                        <Grid>
                            <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center"
                                          Margin="4,0"/>
                            <!-- 🔹 чуть-чуть внутренний отступ -->
                            <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               PopupAnimation="Slide">
                                <Border Background="{DynamicResource MenuPopupBrush}"
                                    BorderBrush="{DynamicResource MenuBorderPopupBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4"
                                    Effect="{DynamicResource PopupShadow}">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- ================= ВЛОЖЕННОЕ ПОДМЕНЮ (например: Интерфейс, Языки) ================= -->
    <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource MenuPopupBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="3"
                        Margin="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <!-- фиксированный отступ под иконку -->
                                <ColumnDefinition Width="*"/>
                                <!-- текст -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- стрелка -->
                            </Grid.ColumnDefinitions>

                            <!-- 🖼️ Иконка (если нет — просто пустое место сохраняется) -->
                            <Image x:Name="IconImage"
                               Grid.Column="0"
                               Source="{TemplateBinding Icon}"
                               Width="16" Height="16"
                               Margin="2,0,4,0"
                               VerticalAlignment="Center"/>

                            <!-- 📝 Текст -->
                            <ContentPresenter Grid.Column="1"
                                          ContentSource="Header"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Margin="0,0,8,0"/>

                            <!-- ▶ Стрелка справа -->
                            <TextBlock Grid.Column="2"
                                   Text="▶"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,5,0"/>

                            <!-- Вложенное меню (Popup) -->
                            <Popup x:Name="PART_Popup"
                               Placement="Right"
                               HorizontalOffset="0"
                               VerticalOffset="-2"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               PopupAnimation="Slide">
                                <Border Background="{DynamicResource MenuPopupBrush}"
                                    BorderBrush="{DynamicResource MenuBorderPopupBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4"
                                    Effect="{DynamicResource PopupShadow}">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>





    <!-- ================= ОБЫЧНЫЙ КОНЕЧНЫЙ ПУНКТ ================= -->
    <Style x:Key="LeafMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="{DynamicResource MenuPopupBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="2,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="3"
                        Margin="1">
                        <DockPanel LastChildFill="True">
                            <!-- ✅ Галочка -->
                            <Path x:Name="CheckMark"
                              Data="M0,5 L3,8 L8,0"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              Visibility="Hidden"
                              VerticalAlignment="Center"
                              Margin="6,0,4,0"/>

                            <!-- 🖼️ Иконка -->
                            <Image x:Name="IconImage"
                               Source="{TemplateBinding Icon}"
                               Width="16" Height="16"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                            <!-- 📝 Текст -->
                            <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Margin="0,0,6,0"/>
                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- если иконки нет — скрываем полностью -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Hover -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>

                        <!-- Checked -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- ================= ПАНЕЛЬ ИКОНОК ================= -->
    <Style x:Key="IconBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True"
                            ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#3399FF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
