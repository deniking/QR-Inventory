<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== КИСТИ (ЦВЕТА) ===== -->
    <SolidColorBrush x:Key="BgBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#2A2A2C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>

    <!-- ===== ВЕРХНИЕ ПУНКТЫ МЕНЮ ("Главная", "Настройки", ...) ===== -->
    <Style x:Key="TopLevelMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            ContentSource="Header"
                            RecognizesAccessKey="True"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1E1E1E"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <!-- Открыто подменю -->
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#777777"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ПОДМЕНЮ ("Пользователь", "Интерфейс", "Тёмная тема"...) ===== -->
    <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="#2A2A2C"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Outer"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3">
                        <Grid>
                            <!-- сам текст пункта -->
                            <ContentPresenter
                                x:Name="HeaderHost"
                                ContentSource="Header"
                                RecognizesAccessKey="True"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <!-- выпадающее дочернее меню (вправо и немного вниз) -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="8"
                                   VerticalOffset="2"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#2A2A2C"
                                        BorderBrush="#2A2A2C"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="#0078D7"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#777777"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== КОНТЕКСТНОЕ МЕНЮ (визуал выпадающих списков) ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#2A2A2C"/>
        <Setter Property="BorderBrush" Value="#2A2A2C"/>
        <!-- без светлой рамки -->
        <Setter Property="BorderThickness" Value="0"/>
        <!-- убираем белую обводку -->
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SubMenuItemStyle}"/>
    </Style>

    <!-- ===== КНОПКИ ИКОНКИ ВО ВТОРОЙ ПАНЕЛИ ===== -->
    <Style x:Key="IconBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="5,0,5,0"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
