<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== КИСТИ (СВЕТЛАЯ ТЕМА) ===== -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="TextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>

    <!-- выпадающее меню -->
    <SolidColorBrush x:Key="MenuPopupBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="MenuBorderPopupBrush" Color="#D0D0D0"/>

    <!-- лёгкая тень под popup-меню -->
    <DropShadowEffect x:Key="PopupShadow"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Opacity="0.25"
                      Color="Gray"/>

    <!-- ================= МЕНЮ: ВЕРХНИЙ УРОВЕНЬ ================= -->
    <Style x:Key="TopMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <Grid>
                            <ContentPresenter ContentSource="Header"
                                              Margin="6,0"
                                              VerticalAlignment="Center"/>

                            <!-- Popup -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource MenuPopupBrush}"
                                        BorderBrush="{StaticResource MenuBorderPopupBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="4"
                                        Effect="{StaticResource PopupShadow}">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                    Value="{StaticResource MenuHoverBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}"/>
                        </Trigger>

                        <!-- Когда подменю открыто -->
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                    Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================= МЕНЮ: ПУНКТ С ВЛОЖЕННЫМ ПРАВЫМ ПОДМЕНЮ ================= -->
    <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="{StaticResource MenuPopupBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Margin="1">
                        <Grid>
                            <ContentPresenter ContentSource="Header"
                                              Margin="6,0,20,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <!-- стрелка -->
                            <TextBlock Text="▶"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,5,0"/>

                            <!-- Popup -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="0"
                                   VerticalOffset="-2"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource MenuPopupBrush}"
                                        BorderBrush="{StaticResource MenuBorderPopupBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="4"
                                        Effect="{StaticResource PopupShadow}">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                    Value="{StaticResource MenuHoverBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================= МЕНЮ: ОБЫЧНЫЙ КОНЕЧНЫЙ ПУНКТ ================= -->
    <Style x:Key="LeafMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="{StaticResource MenuPopupBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Margin="1">
                        <ContentPresenter ContentSource="Header"
                                          Margin="6,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                    Value="{StaticResource MenuHoverBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ================= ПАНЕЛЬ ИКОНОК ================= -->
    <Style x:Key="IconBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="5,0,5,0"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
