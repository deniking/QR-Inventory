<Window x:Class="QR_Inventory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QR-Inventory"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Assets/Icons/app.ico">

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <!-- Верхнее меню -->
            <RowDefinition Height="60"/>
            <!-- Панель иконок -->
            <RowDefinition Height="*"/>
            <!-- Основное поле -->
            <RowDefinition Height="25"/>
            <!-- Нижняя строка -->
        </Grid.RowDefinitions>

        <!-- ====== ГЛАВНОЕ МЕНЮ ====== -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Menu Background="{StaticResource PanelBrush}"
                  Foreground="{StaticResource TextBrush}"
                  FontSize="14"
                  FontWeight="SemiBold"
                  SnapsToDevicePixels="True"
                  Padding="8,0">

                <!-- 🔹 Пункты верхнего меню -->
                <MenuItem Header="Главная" Style="{StaticResource TopMenuItemStyle}"/>
                <MenuItem Header="Компьютеры" Style="{StaticResource TopMenuItemStyle}"/>
                <MenuItem Header="Обслуживание" Style="{StaticResource TopMenuItemStyle}"/>
                <MenuItem Header="Отделы и кабинеты" Style="{StaticResource TopMenuItemStyle}"/>
                <MenuItem Header="Ответственные лица" Style="{StaticResource TopMenuItemStyle}"/>

                <!-- 🔧 Настройки -->
                <MenuItem Header="Настройки" Style="{StaticResource TopMenuItemStyle}">
                    <MenuItem Header="Пользователь"
                              Style="{StaticResource LeafMenuItemStyle}"
                              Click="Settings_User_Click"/>

                    <MenuItem Header="База данных"
                              Style="{StaticResource LeafMenuItemStyle}"
                              Click="Settings_DB_Click"/>

                    <!-- Интерфейс -->
                    <MenuItem Header="Интерфейс"
                              Style="{StaticResource SubMenuItemStyle}">
                        <MenuItem Header="Тёмная тема"
                                  Style="{StaticResource LeafMenuItemStyle}"
                                  Click="SetDarkTheme_Click"/>
                        <MenuItem Header="Светлая тема"
                                  Style="{StaticResource LeafMenuItemStyle}"
                                  Click="SetLightTheme_Click"/>
                    </MenuItem>

                    <MenuItem Header="Telegram-бот"
                              Style="{StaticResource LeafMenuItemStyle}"
                              Click="Settings_Bot_Click"/>
                </MenuItem>

                <MenuItem Header="О программе"
                          Style="{StaticResource TopMenuItemStyle}"
                          Click="About_Click"/>
            </Menu>
        </Border>


        <!-- ====== ПАНЕЛЬ ИКОНОК ====== -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10">

                    <Button Style="{StaticResource IconBarButtonStyle}" ToolTip="Добавить">
                        <Image Source="Assets/Icons/add.png" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBarButtonStyle}" ToolTip="Редактировать">
                        <Image Source="Assets/Icons/edit.png" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBarButtonStyle}" ToolTip="Удалить">
                        <Image Source="Assets/Icons/delete.png" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBarButtonStyle}" ToolTip="Поиск">
                        <Image Source="Assets/Icons/search.png" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBarButtonStyle}" ToolTip="QR-код / Печать стикера">
                        <Image Source="Assets/Icons/qr.png" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBarButtonStyle}" ToolTip="Экспорт">
                        <Image Source="Assets/Icons/export.png" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBarButtonStyle}" ToolTip="Импорт">
                        <Image Source="Assets/Icons/import.png" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBarButtonStyle}" ToolTip="Синхронизация с ботом">
                        <Image Source="Assets/Icons/sync.png" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBarButtonStyle}" ToolTip="Отчёт">
                        <Image Source="Assets/Icons/report.png" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBarButtonStyle}" ToolTip="История изменений">
                        <Image Source="Assets/Icons/history.png" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ====== ОСНОВНОЕ ПОЛЕ ====== -->
        <Grid Grid.Row="2" Background="{StaticResource BgBrush}">
            <TextBlock Text="Добро пожаловать в QR-Inventory"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ====== НИЖНЯЯ СТРОКА ====== -->
        <Border Grid.Row="3"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1,1,1,0">

            <DockPanel Margin="10,0,10,0"
               VerticalAlignment="Center"
               LastChildFill="False">

                <!-- Левая часть -->
                <TextBlock x:Name="StatusText"
                   Text="Готово"
                   Foreground="{StaticResource TextBrush}"
                   DockPanel.Dock="Left"
                   FontSize="13" />

                <!-- Правая часть -->
                <TextBlock x:Name="VersionText"
                   Text="{Binding AppVersion, StringFormat='v{0}'}"
                   Foreground="{StaticResource TextBrush}"
                   DockPanel.Dock="Right"
                   FontSize="13"
                   HorizontalAlignment="Right"
                   TextAlignment="Right" />
            </DockPanel>
        </Border>


    </Grid>
</Window>
